##############################################
# MediaX SessionToken 本地调试环境变量模板
##############################################

# SessionToken HTTP 服务
SESSIONTOKEN_LISTEN_ADDR=":7070"
SESSIONTOKEN_API_TOKEN="dev-session-token"
SESSIONTOKEN_CONFIG="config.yaml"
SESSIONTOKEN_LOG_LEVEL="info"

# Redis
SESSIONTOKEN_REDIS_ADDR="127.0.0.1:6379"
SESSIONTOKEN_REDIS_DB=0
SESSIONTOKEN_REDIS_USERNAME=""
SESSIONTOKEN_REDIS_PASSWORD=""

# 调试页面 / Callback
SESSIONTOKEN_DEBUG_CALLBACK_URL="http://127.0.0.1:7070/debug/callback"
SESSIONTOKEN_DISABLE_DEBUG_PAGE=0

# Zhihu API 代理
SESSIONTOKEN_ZHIHU_API_BASE_URL="https://www.zhihu.com"
SESSIONTOKEN_ZHIHU_PROXY=""
SESSIONTOKEN_ZHIHU_API_VERSION="v4"

# 对齐插件（POWERX_* 与 SessionToken 服务保持一致）
POWERX_SESSION_TOKEN_BASE_URL="http://127.0.0.1:7070"
POWERX_SESSION_TOKEN_API_TOKEN="dev-session-token"
POWERX_SESSION_TOKEN_CALLBACK_URL="https://plugin.local/api/v1/admin/platforms/session-token/callback"
POWERX_SESSION_TOKEN_CALLBACK_SECRET="mediax-sessiontoken-callback"

# 可选：如插件端读取 Redis/网络配置
POWERX_SESSION_TOKEN_REDIS_ADDR="127.0.0.1:6379"
POWERX_SESSION_TOKEN_REDIS_DB=0
